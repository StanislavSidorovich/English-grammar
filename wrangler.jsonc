{
  // Статический сайт на Cloudflare Workers. Сборки нет — Worker-скрипта тоже:
  // раздаются только файлы из репозитория, поэтому поле "main" не нужно.
  "name": "english-grammar",
  "compatibility_date": "2026-08-09",
  "assets": {
    // Корень репозитория; что не отдавать наружу — перечислено в .assetsignore
    "directory": "./"
  }
}
